# Application
APP_NAME="Smart Pricing System"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production

# API Server
API_HOST="0.0.0.0"
API_PORT=8000
API_RELOAD=true

# Database (PostgreSQL)
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="smart_pricing"
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_ECHO=false

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_TTL=300  # seconds

# Configuration Files
CONFIG_BASE_PATH="config/base.yaml"
CONFIG_PRICING_RULES_PATH="config/pricing_rules.yaml"
CONFIG_ZONES_PATH="config/zones.yaml"
CONFIG_COMPETITIONS_PATH="config/competitions.yaml"

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="json"  # json or text
LOG_FILE="logs/app.log"

# Pricing Engine
PRICING_UPDATE_INTERVAL=300  # seconds
PRICING_MIN_CHANGE_THRESHOLD=0.5  # euros
PRICING_MAX_DAILY_CHANGES=5

# Machine Learning
ML_MODEL_PATH="models/demand_model.pkl"
ML_RETRAIN_INTERVAL=604800  # seconds (7 days)

# External APIs
FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_API_URL="https://api.football-data.org/v4"
WEATHER_API_KEY=""
WEATHER_API_URL="https://api.openweathermap.org/data/2.5"

# Google Analytics
GA_PROPERTY_ID=""
GA_CREDENTIALS_PATH="credentials/google-analytics.json"

# Security
SECRET_KEY="change-this-to-a-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Workers
WORKER_PRICE_UPDATER_INTERVAL=300  # seconds
WORKER_DATA_COLLECTOR_INTERVAL=3600  # seconds
WORKER_MODEL_RETRAINER_INTERVAL=604800  # seconds (7 days)

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Venue Information
STADIUM_NAME="Son Moix"
STADIUM_CAPACITY=23142
STADIUM_LATITUDE=39.590
STADIUM_LONGITUDE=2.630
